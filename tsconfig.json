{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@briday1/layout": ["./packages/layout/src/index.ts"],
      "@briday1/layout-pug-sankey": ["./packages/pug-sankey/src/index.ts"],
      "@briday1/layout-pugflow": ["./packages/pugflow/src/index.ts"],
      "@briday1/layout-jsonantt": ["./packages/jsonantt/src/index.ts"]
    },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true
  },
  "include": ["packages/*/src", "examples/*/src", "tests", "vitest.config.ts"]
}
